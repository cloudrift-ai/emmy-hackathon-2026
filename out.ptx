        add.u32 %r13, %r5, 2;
        mul.wide.u32 %rd9, %r5, 4;
        mov.u64 %rd10, acc0_smem;
        add.s64 %rd11, %rd10, %rd9;
        ld.shared.f32 %f12, [%rd11];
        mul.wide.u32 %rd12, %r13, 4;
        mov.u64 %rd13, acc0_smem;
