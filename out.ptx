END_0:


        shfl.sync.bfly.b32 %f2, %f0, 16, 0x1f, 0xffffffff;
        add.f32 %f3, %f0, %f2;
        shfl.sync.bfly.b32 %f4, %f3, 8, 0x1f, 0xffffffff;
